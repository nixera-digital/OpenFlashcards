# Copy to .env and adjust
#   cp .env.example .env

# App listen address for docker-compose.yml host bind
#   127.0.0.1 — only this machine (default, safer)
#   0.0.0.0   — LAN / phone access
APP_LISTEN=127.0.0.1
PORT=8000

# Session HMAC — REQUIRED in production (openssl rand -hex 32)
JWT_SECRET=change_this_to_a_random_secret

# Host paths when running without Docker (npm start)
DATA_DIR=./data
CONFIG_DIR=./config
